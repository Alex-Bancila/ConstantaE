# Copy this file to .env and fill it in. Never commit .env: the repo is public.

# mock = fixed fake AI results, no models or API keys needed. real = run the real AI code.
AI_MODE=mock

# false = run each analysis inside the request. true = send it to the job queue.
ASYNC=false

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/constantae
REDIS_URL=redis://localhost:6379
RESULT_TTL_SECONDS=86400
LLM_API_KEY=
